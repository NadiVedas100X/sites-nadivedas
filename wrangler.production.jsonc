{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sites-nadivedas-git",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nadi-website-production",
      "database_id": "9a752e84-2bab-431b-b438-354acf512d99"
    }
  ],
  "r2_buckets": [
    {
      "binding": "THUMBPRINTS",
      "bucket_name": "nadi-website-thumbprints"
    }
  ],
  "vars": {
    "STATEFUL_API_MODE": "bridge"
  },
  "observability": { "enabled": true }
}
